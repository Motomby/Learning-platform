# ═════════════════════════════════════════════════════════════════════
#  E-LEARNING PLATFORM — ENVIRONMENT VARIABLES
#  Copy this file to .env for local development.
#  On Render, paste each KEY=VALUE into the dashboard:
#    Dashboard → Web Service → Environment → Environment Variables
# ═════════════════════════════════════════════════════════════════════

# ─── Node Runtime (REQUIRED) ───────────────────────────────────────────
NODE_ENV=production
PORT=10000

# ─── Security (REQUIRED — change the default!) ─────────────────────────
# 🔐 Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=please_change_me_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# ─── Database (REQUIRED on Render) ─────────────────────────────────────
# Use MongoDB Atlas or Render-managed MongoDB (or external):
#   Atlas format:  mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/elearning?retryWrites=true&w=majority
#   Render format: get the connection string after creating a Render MongoDB instance
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/elearning_platform?retryWrites=true&w=majority

# ─── CORS (REQUIRED — your frontend URLs) ──────────────────────────────
# Comma-separated list of allowed origins. Don't include trailing slashes.
# Example (separate frontends on Render + localhost dev):
CORS_ORIGINS=https://your-frontend.onrender.com,http://localhost:3000

# ─── Email (OPTIONAL — enables real verification emails) ───────────────
# Without these, verification codes are logged to the Render service logs
# (Console fallback — signups still work, users get their code from logs).
# Recommended SMTP providers: Resend, SendGrid, Mailgun, Gmail (App Password).
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend_api_key_username
SMTP_PASS=your_resend_api_key_here
EMAIL_FROM="LearnHub <onboarding@your-domain.com>"
